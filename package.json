{
  "name": "macos-dock",
  "version": "1.0.0",
  "description": "macOS-style dock for Linux and Windows",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -- --ozone-platform=x11 --no-sandbox --disable-gpu-compositing --in-process-gpu",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  }
}
